{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist/esm",
    "rootDir": "lib",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2019", "DOM"]
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
